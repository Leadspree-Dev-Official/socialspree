# ---------------------------------------------------------------------------
# Browser build variables (public — these ship inside the JS bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Customer-facing contact details
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_WHATSAPP=919051822558
VITE_SUPPORT_WHATSAPP_DISPLAY=+91 90518 22558

# Shown on invoices and receipts. GST is required for Indian B2B invoicing.
VITE_BILLING_ENTITY_NAME=SocialSpree
VITE_BILLING_GST_NUMBER=

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`.
# These are NEVER placed in this file or any file the browser can reach.
# ---------------------------------------------------------------------------
#
#   Required to publish anything
#     COMPOSIO_API_KEY            Publishing engine (primary)
#
#   Required for media uploads to be signed rather than unsigned
#     CLOUDINARY_CLOUD_NAME       e.g. djmww1dwr
#     CLOUDINARY_API_KEY
#     CLOUDINARY_API_SECRET       Without these, uploads fall back to an
#                                 unsigned preset and log a warning.
#
#   Required for scheduled publishing
#     WORKER_SECRET               Shared secret the cron sweeper presents.
#                                 Also store it in the database so pg_cron can
#                                 authenticate. All three keys are required —
#                                 anon_key satisfies the platform gateway, which
#                                 rejects a request with no Authorization header
#                                 before it reaches the function:
#                                   select private.set_worker_config('supabase_url', 'https://<ref>.supabase.co');
#                                   select private.set_worker_config('worker_secret', '<WORKER_SECRET>');
#                                   select private.set_worker_config('anon_key', '<publishable key>');
#
#   Required for the comment autoresponder
#     META_APP_SECRET             Verifies inbound webhook signatures
#     META_WEBHOOK_VERIFY_TOKEN   Handshake token you also enter in Meta
#     META_GRAPH_VERSION          Optional, defaults to v21.0
#                                 Each workspace additionally stores a page
#                                 access token in the encrypted credential
#                                 vault (provider 'meta', label 'page_token').
#
#   Required for AI captions and connector image generation
#     OPENAI_API_KEY
#     OPENAI_MODEL                Optional, defaults to gpt-4.1-mini
#
#   Required once Razorpay activation clears
#     RAZORPAY_KEY_ID
#     RAZORPAY_KEY_SECRET
#     RAZORPAY_WEBHOOK_SECRET
#
#   Required for the encrypted provider credential vault
#     CREDENTIAL_ENCRYPTION_KEY   Any high-entropy string; rotating it
#                                 invalidates every stored provider credential.
#
#   Security boundaries
#     ALLOWED_WEB_ORIGINS         Comma-separated origins allowed to call the
#                                 functions, e.g. https://app.yourdomain.com
#     ALLOWED_OAUTH_REDIRECTS     Comma-separated exact callback URLs
#
#   Optional — only for native (non-Composio) OAuth
#     OAUTH_PROVIDERS             e.g. META,LINKEDIN
#     <PROVIDER>_CLIENT_ID / _CLIENT_SECRET / _AUTHORIZE_URL / _TOKEN_URL
#
