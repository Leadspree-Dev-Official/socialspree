{
  "openapi": "3.1.0",
  "info": {
    "title": "SocialSpree ChatGPT Publishing & Scheduling Plugin",
    "description": "Enables ChatGPT to schedule and publish social media posts, images, reels, and carousel campaigns directly into SocialSpree.",
    "version": "2.1.0"
  },
  "servers": [
    {
      "url": "https://qglhbesenigpspgkgbac.supabase.co/functions/v1/chatgpt-connector"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "List Connected Social Accounts",
        "description": "Retrieves all active social media accounts (Instagram, LinkedIn, X, TikTok, YouTube, Facebook) connected to the user's SocialSpree workspace.",
        "operationId": "listConnectedAccounts",
        "responses": {
          "200": {
            "description": "List of available social media accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "workspace": {
                      "type": "object",
                      "properties": {
                        "tenantId": { "type": "string" },
                        "tenantName": { "type": "string" },
                        "connectedChannelsCount": { "type": "integer" }
                      }
                    },
                    "availableChannels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "accountId": { "type": "string" },
                          "platform": { "type": "string" },
                          "accountName": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Schedule or Publish a Post with Image / Caption",
        "description": "Takes an image URL or text caption and schedules it into SocialSpree's calendar and background publishing queue.",
        "operationId": "scheduleSocialPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["caption"],
                "properties": {
                  "imageUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "The public HTTPS URL of the image."
                  },
                  "caption": {
                    "type": "string",
                    "description": "The text content, hashtags, and call to action for the post."
                  },
                  "scheduledAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 timestamp for scheduling (e.g. 2026-08-20T18:00:00Z). Omit or set past date to publish immediately."
                  },
                  "targetChannels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of platforms (e.g. ['instagram', 'linkedin', 'x', 'tiktok', 'youtube', 'facebook']) or account IDs to post to."
                  },
                  "publishNow": {
                    "type": "boolean",
                    "description": "Set to true to dispatch immediately, or false to schedule for later."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post scheduled successfully in SocialSpree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" },
                    "postId": { "type": "string" },
                    "jobId": { "type": "string" },
                    "scheduledAt": { "type": "string" },
                    "targetChannels": { "type": "array" },
                    "preview": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
